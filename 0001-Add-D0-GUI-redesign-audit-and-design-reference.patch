+             transform: translateX(-50%); width: 250px; padding: 8px 10px;
+             border-radius: 6px; border: 1px solid; font-size: 13px; line-height: 1.45;
+             z-index: 5; text-align: left; }
+.mini-dot.attention:hover .hover-msg { display: block; }
+.window { width: 960px; max-width: 100%; margin: 8px 0 0; border: 1px solid;
+          border-radius: 8px; overflow: hidden; }
+.window.slim { width: 560px; }
+.titlebar { height: 36px; display: flex; align-items: center; justify-content: space-between;
+            padding: 0 12px; border-bottom: 1px solid rgba(128,128,128,0.25); }
+.tb-title { font-size: 13px; }
+.tb-controls { display: inline-flex; gap: 18px; align-items: center; }
+.tb-glyph { width: 10px; height: 1.5px; background: #9a9a9a; position: relative; display: inline-block; }
+.tb-glyph.square { width: 9px; height: 9px; background: none; border: 1.2px solid #9a9a9a; }
+.tb-glyph.x { width: 11px; height: 11px; background: none; }
+.tb-glyph.x::before, .tb-glyph.x::after { content: ""; position: absolute; left: 0; top: 5px;
+          width: 11px; height: 1.2px; background: #9a9a9a; }
+.tb-glyph.x::before { transform: rotate(45deg); }
+.tb-glyph.x::after { transform: rotate(-45deg); }
+.window-body { display: flex; align-items: stretch; }
+.rail { width: 208px; flex: none; border-right: 1px solid; display: flex;
+        flex-direction: column; padding: 12px 0; }
+.wordmark { font-family: var(--serif); font-size: 18px; padding: 8px 16px 16px; }
+.nav-item { height: 36px; display: flex; align-items: center; padding-left: 19px;
+            font-size: 14px; position: relative; }
+.nav-bar { position: absolute; left: 0; top: 8px; width: 3px; height: 20px; border-radius: 2px; }
+.rail-bottom { margin-top: auto; padding: 12px 16px 4px; display: flex;
+               flex-direction: column; gap: 8px; }
+.switch-mini { font-size: 14px; }
+.status { display: inline-flex; align-items: center; font-size: 14px; }
+.status .dot { width: 8px; height: 8px; border-radius: 999px; display: inline-block; }
+.content { padding: 32px; flex: 1; }
+.page-title { font-family: var(--serif); font-size: 28px; font-weight: 500; }
+.page-sub { font-size: 14px; margin: 4px 0 24px; }
+.cards { display: flex; flex-direction: column; gap: 16px; max-width: 640px; }
+.card { border: 1px solid; border-radius: 10px; padding: 16px; }
+.card-title { font-size: 15px; font-weight: 500; margin-bottom: 10px; }
+.card-body { display: flex; flex-direction: column; gap: 4px; }
+.big-line { font-size: 14px; }
+.hotkey-row { display: flex; gap: 10px; align-items: center; }
+.chip { display: inline-flex; align-items: center; justify-content: center;
+        min-width: 44px; height: 36px; padding: 0 14px; border: 1px solid;
+        border-radius: 6px; font-size: 14px; }
+.chip-plus { font-size: 14px; }
+.action { font-size: 14px; margin-top: 6px; }
+.row { min-height: 44px; display: flex; justify-content: space-between; align-items: center;
+       gap: 24px; padding: 2px 0; }
+.row + .row { border-top: 1px solid rgba(128,128,128,0.12); }
+.label { font-size: 14px; }
+.helper { font-size: 13px; margin-top: 2px; max-width: 420px; }
+.note { font-size: 13px; margin-top: 4px; }
+.row-control { display: flex; align-items: center; gap: 10px; flex: none; }
+.value { font-size: 14px; }
+.transcript { font-size: 14px; line-height: 1.55; }
+.row-actions { margin-top: 10px; display: flex; gap: 12px; }
+.btn { display: inline-flex; align-items: center; height: 32px; padding: 0 16px;
+       border: 1px solid; border-radius: 6px; font-size: 14px; }
+.btn.primary { border: none; }
+.toggle { position: relative; width: 52px; height: 32px; border-radius: 999px;
+          display: inline-block; flex: none; }
+.knob { position: absolute; top: 4px; width: 24px; height: 24px; border-radius: 999px; }
+.dropdown { display: inline-flex; align-items: center; justify-content: space-between;
+            gap: 16px; height: 32px; min-width: 200px; padding: 0 12px;
+            border: 1px solid; border-radius: 6px; font-size: 14px; }
+.chev { width: 0; height: 0; border-left: 4px solid transparent;
+        border-right: 4px solid transparent; border-top: 5px solid; }
+.token-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; margin-top: 8px; }
+.token-h { font-size: 13px; font-weight: 600; text-transform: uppercase;
+           letter-spacing: 0.06em; color: var(--doc-muted); margin-bottom: 10px; }
