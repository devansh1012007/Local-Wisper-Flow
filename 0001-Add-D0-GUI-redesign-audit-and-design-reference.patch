+            border-bottom: 1px solid #D8D3C2; }
+.s1 { font-family: var(--serif); font-size: 28px; }
+.s2 { font-family: var(--serif); font-size: 18px; }
+.s3 { font-size: 15px; font-weight: 500; }
+.s4 { font-size: 14px; }
+.s5 { font-size: 13px; color: #5B665F; }
+.space-row { display: flex; align-items: center; gap: 10px; padding: 4px 0; }
+.space-bar { height: 10px; border-radius: 3px; display: inline-block; }
+.radii-row { display: flex; gap: 12px; flex-wrap: wrap; }
+.radius-chip { display: inline-flex; align-items: center; justify-content: center;
+               height: 44px; padding: 0 14px; border: 1px solid; font-size: 13px; }
+.r6 { border-radius: 6px; }
+.r10 { border-radius: 10px; }
+.r999 { border-radius: 999px; }
