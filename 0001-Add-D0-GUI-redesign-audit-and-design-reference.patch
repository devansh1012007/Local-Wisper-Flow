+               border: 1px solid; border-radius: 6px; font-size: 14px;
+               outline: 2px solid; outline-offset: 2px; }
+.controls-strip { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
+.saved { font-size: 13px; }
+.mini-table td { border-bottom: 1px solid #D8D3C2; }
+.notice { border: 1px solid #D8D3C2; background: #F6F3E8; border-radius: 10px;
