diff --git a/src/stt/cloud/IHttpTransport.h b/src/stt/cloud/IHttpTransport.h
new file mode 100644
index 0000000..041b546
--- /dev/null
+++ b/src/stt/cloud/IHttpTransport.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+struct HttpRequest {
+    std::string host;
+    std::string path;
+    std::vector<std::pair<std::string, std::string>> headers;
+    std::string content_type;
+    std::vector<std::uint8_t> body;
+    int timeout_ms = 15000;
+};
+
+struct HttpResponse {
+    int status = 0;
+    std::vector<std::pair<std::string, std::string>> headers;
+    std::vector<std::uint8_t> body;
+
+    std::string Header(const std::string& name) const {
+        for (const auto& header : headers) {
+            if (header.first.size() == name.size()) {
+                bool equal = true;
+                for (std::size_t i = 0; i < name.size(); ++i) {
+                    const char left = static_cast<char>(header.first[i] | 0x20);
+                    const char right = static_cast<char>(name[i] | 0x20);
+                    if (left != right) {
+                        equal = false;
+                        break;
+                    }
+                }
+                if (equal) {
+                    return header.second;
+                }
+            }
+        }
+        return {};
+    }
+};
+
+enum class HttpTransportErrorKind {
+    Timeout,
+    Network,
+};
+
+class HttpTransportError : public std::runtime_error {
+public:
+    HttpTransportError(HttpTransportErrorKind kind, const std::string& what)
+        : std::runtime_error(what), kind_(kind) {}
+
+    HttpTransportErrorKind Kind() const {
+        return kind_;
+    }
+
+private:
+    HttpTransportErrorKind kind_;
+};
+
+class IHttpTransport {
+public:
+    virtual ~IHttpTransport() = default;
+
+    virtual HttpResponse Post(const HttpRequest& request) = 0;
+};
diff --git a/tests/gnani_request_test.cpp b/tests/gnani_request_test.cpp
new file mode 100644
index 0000000..411a34e
--- /dev/null
+++ b/tests/gnani_request_test.cpp
@@ -0,0 +1,103 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/GnaniContract.h"
+#include "stt/cloud/GnaniRequest.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::string AsString(const std::vector<std::uint8_t>& bytes) {
+    return std::string(bytes.begin(), bytes.end());
+}
+
+bool Contains(const std::vector<std::uint8_t>& haystack, const std::string& needle) {
+    return std::search(haystack.begin(), haystack.end(), needle.begin(), needle.end()) !=
+           haystack.end();
+}
+
+std::size_t Count(const std::string& haystack, char needle) {
+    return static_cast<std::size_t>(
+        std::count(haystack.begin(), haystack.end(), needle));
+}
+
+GnaniRequestOptions Options() {
+    GnaniRequestOptions options;
+    options.api_key_id = "test-key-id";
+    options.model = "prisma-v3.0";
+    options.language = "indic-auto";
+    return options;
+}
+
+}  // namespace
+
+TEST_CASE("gnani request targets the documented endpoint and headers") {
+    const std::vector<float> pcm(16, 0.0f);
+    const HttpRequest request = BuildGnaniRequest(pcm, 16000, Options());
+    CHECK(request.host == GnaniContract::kHost);
+    CHECK(request.path == GnaniContract::kPath);
+    REQUIRE(request.headers.size() == 1);
+    CHECK(request.headers[0].first == "X-API-Key-ID");
+    CHECK(request.headers[0].second == "test-key-id");
+    CHECK(request.content_type.find("multipart/form-data") == 0);
+    CHECK(request.content_type.find(GnaniContract::kBoundary) != std::string::npos);
+}
+
+TEST_CASE("gnani request embeds model, language, and wav audio") {
+    const std::vector<float> pcm{0.5f, -0.5f, 0.25f};
+    const HttpRequest request = BuildGnaniRequest(pcm, 16000, Options());
+    CHECK(Contains(request.body, "name=\"model\"\r\n\r\nprisma-v3.0"));
+    CHECK(Contains(request.body, "name=\"language\"\r\n\r\nindic-auto"));
+    CHECK(Contains(request.body, "name=\"audio\"; filename=\"audio.wav\""));
+    CHECK(Contains(request.body, "Content-Type: audio/wav"));
+    CHECK(Contains(request.body, "RIFF"));
+    CHECK(Contains(request.body, "WAVE"));
+    const std::string body = AsString(request.body);
+    const std::string expected_tail = "\r\n--" + std::string(GnaniContract::kBoundary) + "--\r\n";
+    CHECK(body.substr(body.size() - expected_tail.size()) == expected_tail);
+}
+
+TEST_CASE("gnani request omits the keyterms field when none are given") {
+    const std::vector<float> pcm(4, 0.0f);
+    const HttpRequest request = BuildGnaniRequest(pcm, 16000, Options());
+    CHECK(!Contains(request.body, "name=\"keyterms\""));
+}
+
+TEST_CASE("gnani request caps and filters keyterms") {
+    const std::vector<float> pcm(4, 0.0f);
+    GnaniRequestOptions options = Options();
+    for (std::size_t i = 0; i < 260; ++i) {
+        options.keyterms.push_back("term" + std::to_string(i));
+    }
+    options.keyterms.push_back("unsafe,term");
+    options.keyterms.push_back("unsafe\r\nterm");
+    options.keyterms.push_back("");
+    const HttpRequest request = BuildGnaniRequest(pcm, 16000, options);
+    const std::string body = AsString(request.body);
+    const std::size_t field = body.find("name=\"keyterms\"\r\n\r\n");
+    REQUIRE(field != std::string::npos);
+    const std::size_t value_begin = field + std::string("name=\"keyterms\"\r\n\r\n").size();
+    const std::size_t value_end = body.find("\r\n--", value_begin);
+    const std::string joined = body.substr(value_begin, value_end - value_begin);
+    CHECK(Count(joined, ',') == GnaniContract::kKeytermsCap - 1);
+    CHECK(joined.find("term199") != std::string::npos);
+    CHECK(joined.find("term200") == std::string::npos);
+    CHECK(joined.find("unsafe") == std::string::npos);
+}
+
+TEST_CASE("gnani request rejects missing credentials and settings") {
+    const std::vector<float> pcm(4, 0.0f);
+    GnaniRequestOptions options = Options();
+    options.api_key_id = "";
+    CHECK_THROWS_AS(BuildGnaniRequest(pcm, 16000, options), std::runtime_error);
+    options = Options();
+    options.model = "";
+    CHECK_THROWS_AS(BuildGnaniRequest(pcm, 16000, options), std::runtime_error);
+    options = Options();
+    options.language = "";
+    CHECK_THROWS_AS(BuildGnaniRequest(pcm, 16000, options), std::runtime_error);
+}
diff --git a/tests/gnani_response_test.cpp b/tests/gnani_response_test.cpp
new file mode 100644
index 0000000..3af26ce
--- /dev/null
+++ b/tests/gnani_response_test.cpp
@@ -0,0 +1,110 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/GnaniResponse.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::vector<std::uint8_t> Bytes(const std::string& text) {
+    return std::vector<std::uint8_t>(text.begin(), text.end());
+}
+
+}  // namespace
+
+TEST_CASE("gnani response parses a success with transcript and header request id") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"transcript":"namaskara loka"})"), "req-123", success,
+                             failure));
+    CHECK(success.transcript == "namaskara loka");
+    CHECK(success.request_id == "req-123");
+}
+
+TEST_CASE("gnani response treats an empty transcript as success") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"transcript":""})"), "req-456", success, failure));
+    CHECK(success.transcript.empty());
+    CHECK(success.request_id == "req-456");
+}
+
+TEST_CASE("gnani response falls back to alternate transcript field names") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"text":"via text"})"), "", success, failure));
+    CHECK(success.transcript == "via text");
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"data":{"transcript":"nested"}})"), "", success,
+                             failure));
+    CHECK(success.transcript == "nested");
+}
+
+TEST_CASE("gnani response picks the body request id when the header is absent") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"transcript":"hi","request_id":"body-id"})"), "",
+                             success, failure));
+    CHECK(success.request_id == "body-id");
+}
+
+TEST_CASE("gnani response parses the error object shape") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(401,
+                              Bytes(R"({"error":{"code":"invalid_api_key","message":"key rejected"}})"),
+                              "req-1", success, failure));
+    CHECK(failure.category == SttErrorCategory::Auth);
+    CHECK(failure.http_status == 401);
+    CHECK(failure.request_id == "req-1");
+    CHECK(failure.detail == "invalid_api_key: key rejected");
+}
+
+TEST_CASE("gnani response parses the error string shape") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(429, Bytes(R"({"error":"too many requests"})"), "", success,
+                              failure));
+    CHECK(failure.category == SttErrorCategory::RateLimited);
+    CHECK(failure.detail == "too many requests");
+}
+
+TEST_CASE("gnani response parses the message and detail shapes") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(500, Bytes(R"({"message":"upstream burst"})"), "req-2", success,
+                              failure));
+    CHECK(failure.category == SttErrorCategory::Server);
+    CHECK(failure.detail == "upstream burst");
+    CHECK(!ParseGnaniResponse(400, Bytes(R"({"detail":"audio must be 16 kHz"})"), "", success,
+                              failure));
+    CHECK(failure.category == SttErrorCategory::InvalidRequest);
+    CHECK(failure.detail == "audio must be 16 kHz");
+}
+
+TEST_CASE("gnani response classifies transport level status codes") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(403, Bytes(R"({})"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Auth);
+    CHECK(!ParseGnaniResponse(408, Bytes(R"({})"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Timeout);
+    CHECK(!ParseGnaniResponse(413, Bytes(R"({})"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::PayloadTooLarge);
+    CHECK(!ParseGnaniResponse(503, Bytes("{}"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Server);
+}
+
+TEST_CASE("gnani response survives malformed bodies without throwing") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(200, Bytes("not json at all"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Unknown);
+    CHECK(!ParseGnaniResponse(500, Bytes("still not json"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Server);
+    CHECK(!ParseGnaniResponse(200, Bytes("[]"), "", success, failure));
+    CHECK(failure.detail == "success body is not a JSON object");
+    CHECK(!ParseGnaniResponse(200, Bytes(R"({"unexpected":"shape"})"), "", success, failure));
+    CHECK(failure.detail == "no transcript field in success body");
+}
