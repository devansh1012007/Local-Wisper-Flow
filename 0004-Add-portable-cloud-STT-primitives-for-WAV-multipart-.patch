diff --git a/tests/clip_splitter_test.cpp b/tests/clip_splitter_test.cpp
new file mode 100644
index 0000000..6d024b0
--- /dev/null
+++ b/tests/clip_splitter_test.cpp
@@ -0,0 +1,76 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/ClipSplitter.h"
+
+#include <cstddef>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+
+std::vector<float> Speech(std::size_t samples) {
+    return std::vector<float>(samples, 0.3f);
+}
+
+std::vector<float> SilentSpeechMix(std::size_t total_samples, std::size_t silence_begin,
+                                   std::size_t silence_frames) {
+    std::vector<float> pcm = Speech(total_samples);
+    for (std::size_t i = 0; i < silence_frames && silence_begin + i < total_samples; ++i) {
+        pcm[silence_begin + i] = 0.0001f;
+    }
+    return pcm;
+}
+
+}  // namespace
+
+TEST_CASE("clip splitter returns one clip for short audio") {
+    const std::vector<float> pcm = Speech(80000);
+    const std::vector<AudioClip> clips = SplitIntoClips(pcm, 16000, 29500);
+    REQUIRE(clips.size() == 1);
+    CHECK(clips[0].begin == 0);
+    CHECK(clips[0].frames == 80000);
+}
+
+TEST_CASE("clip splitter hard cuts continuous audio at the limit") {
+    const std::vector<float> pcm = Speech(1040000);
+    const std::vector<AudioClip> clips = SplitIntoClips(pcm, 16000, 29500);
+    REQUIRE(clips.size() == 3);
+    CHECK(clips[0].begin == 0);
+    CHECK(clips[0].frames == 472000);
+    CHECK(clips[1].begin == 472000);
+    CHECK(clips[1].frames == 472000);
+    CHECK(clips[2].begin == 944000);
+    CHECK(clips[2].frames == 96000);
+}
+
+TEST_CASE("clip splitter prefers silence near the boundary") {
+    const std::vector<float> pcm = SilentSpeechMix(640000, 448000, 512);
+    const std::vector<AudioClip> clips = SplitIntoClips(pcm, 16000, 29500);
+    REQUIRE(clips.size() == 2);
+    CHECK(clips[0].begin == 0);
+    CHECK(clips[0].frames == 448512);
+    CHECK(clips[1].begin == 448512);
+    CHECK(clips[1].frames == 191488);
+}
+
+TEST_CASE("clip splitter ignores silence far from the boundary") {
+    const std::vector<float> pcm = SilentSpeechMix(640000, 320000, 512);
+    const std::vector<AudioClip> clips = SplitIntoClips(pcm, 16000, 29500);
+    REQUIRE(clips.size() == 2);
+    CHECK(clips[0].begin == 0);
+    CHECK(clips[0].frames == 472000);
+    CHECK(clips[1].begin == 472000);
+    CHECK(clips[1].frames == 168000);
+}
+
+TEST_CASE("clip splitter returns no clips for empty audio") {
+    const std::vector<float> pcm;
+    const std::vector<AudioClip> clips = SplitIntoClips(pcm, 16000, 29500);
+    CHECK(clips.empty());
+}
+
+TEST_CASE("clip splitter rejects zero limits") {
+    const std::vector<float> pcm = Speech(1000);
+    CHECK_THROWS_AS(SplitIntoClips(pcm, 0, 29500), std::runtime_error);
+    CHECK_THROWS_AS(SplitIntoClips(pcm, 16000, 0), std::runtime_error);
+}
diff --git a/tests/multipart_builder_test.cpp b/tests/multipart_builder_test.cpp
new file mode 100644
index 0000000..e5544a9
--- /dev/null
+++ b/tests/multipart_builder_test.cpp
@@ -0,0 +1,95 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/MultipartBuilder.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::string AsString(const std::vector<std::uint8_t>& bytes) {
+    return std::string(bytes.begin(), bytes.end());
+}
+
+std::size_t Find(const std::vector<std::uint8_t>& haystack, const std::string& needle,
+                 std::size_t from = 0) {
+    const auto it = std::search(haystack.begin() + static_cast<std::ptrdiff_t>(from),
+                                haystack.end(), needle.begin(), needle.end());
+    return it == haystack.end() ? std::string::npos
+                                : static_cast<std::size_t>(it - haystack.begin());
+}
+
+const std::vector<std::uint8_t> kBinaryPayload{0x01, 0x00, 0xFF, 0x0D, 0x0A, 0x00, 0xFE, 0x7F};
+const std::string kTerminator = "\r\n--BOUND--\r\n";
+
+}  // namespace
+
+TEST_CASE("multipart builder emits fields in canonical form") {
+    MultipartBuilder builder("BOUND");
+    builder.AddField("model", "prisma-v3.0");
+    const std::vector<std::uint8_t> body = builder.Build();
+    CHECK(AsString(body) ==
+          "--BOUND\r\nContent-Disposition: form-data; name=\"model\"\r\n\r\nprisma-v3.0\r\n"
+          "--BOUND--\r\n");
+}
+
+TEST_CASE("multipart builder emits file parts with content type and payload") {
+    MultipartBuilder builder("BOUND");
+    builder.AddField("language", "indic-auto");
+    builder.AddFile("audio", "audio.wav", "audio/wav", kBinaryPayload);
+    const std::vector<std::uint8_t> body = builder.Build();
+    const std::string expected_field =
+        "--BOUND\r\nContent-Disposition: form-data; name=\"language\"\r\n\r\nindic-auto\r\n";
+    const std::string expected_header =
+        "--BOUND\r\nContent-Disposition: form-data; name=\"audio\"; filename=\"audio.wav\"\r\n"
+        "Content-Type: audio/wav\r\n\r\n";
+    const std::size_t field_offset = Find(body, expected_field);
+    const std::size_t header_offset = Find(body, expected_header);
+    REQUIRE(field_offset == 0);
+    REQUIRE(header_offset == expected_field.size());
+    const std::size_t payload_offset = header_offset + expected_header.size();
+    REQUIRE(body.size() == payload_offset + kBinaryPayload.size() + kTerminator.size());
+    for (std::size_t i = 0; i < kBinaryPayload.size(); ++i) {
+        CHECK(body[payload_offset + i] == kBinaryPayload[i]);
+    }
+    CHECK(AsString(std::vector<std::uint8_t>(body.end() - static_cast<std::ptrdiff_t>(kTerminator.size()),
+                                            body.end())) == kTerminator);
+}
+
+TEST_CASE("multipart builder keeps binary payloads byte exact") {
+    MultipartBuilder builder("BOUND");
+    builder.AddFile("audio", "clip.wav", "audio/wav", kBinaryPayload);
+    const std::vector<std::uint8_t> body = builder.Build();
+    const std::string header =
+        "--BOUND\r\nContent-Disposition: form-data; name=\"audio\"; filename=\"clip.wav\"\r\n"
+        "Content-Type: audio/wav\r\n\r\n";
+    const std::size_t payload_offset = Find(body, header) + header.size();
+    for (std::size_t i = 0; i < kBinaryPayload.size(); ++i) {
+        CHECK(body[payload_offset + i] == kBinaryPayload[i]);
+    }
+}
+
+TEST_CASE("multipart builder rejects header and value injection") {
+    CHECK_THROWS_AS(MultipartBuilder builder(""), std::runtime_error);
+    CHECK_THROWS_AS(MultipartBuilder builder("bad\r\nboundary"), std::runtime_error);
+    MultipartBuilder builder("BOUND");
+    CHECK_THROWS_AS(builder.AddField("name\"; evil", "v"), std::runtime_error);
+    CHECK_THROWS_AS(builder.AddField("model", "v\r\nX-Evil: 1"), std::runtime_error);
+    CHECK_THROWS_AS(builder.AddField("model", "v--BOUND--"), std::runtime_error);
+    CHECK_THROWS_AS(builder.AddFile("audio", "a.wav\r\nEvil", "audio/wav", {}), std::runtime_error);
+    CHECK_THROWS_AS(builder.AddFile("audio", "a.wav", "audio/wav \"x\"", {}), std::runtime_error);
+}
+
+TEST_CASE("multipart builder with no parts emits only the terminator") {
+    MultipartBuilder builder("BOUND");
+    const std::vector<std::uint8_t> body = builder.Build();
+    CHECK(AsString(body) == "--BOUND--\r\n");
+}
+
+TEST_CASE("multipart builder content type carries the boundary") {
+    MultipartBuilder builder("lwf-abc123");
+    CHECK(builder.ContentType() == "multipart/form-data; boundary=lwf-abc123");
+}
diff --git a/tests/wav_encoder_test.cpp b/tests/wav_encoder_test.cpp
new file mode 100644
index 0000000..15fe706
--- /dev/null
+++ b/tests/wav_encoder_test.cpp
@@ -0,0 +1,85 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/WavEncoder.h"
+
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::uint16_t ReadU16(const std::vector<std::uint8_t>& bytes, std::size_t offset) {
+    return static_cast<std::uint16_t>(static_cast<std::uint16_t>(bytes[offset]) |
+                                      (static_cast<std::uint16_t>(bytes[offset + 1]) << 8));
+}
+
+std::uint32_t ReadU32(const std::vector<std::uint8_t>& bytes, std::size_t offset) {
+    return static_cast<std::uint32_t>(bytes[offset]) |
+           (static_cast<std::uint32_t>(bytes[offset + 1]) << 8) |
+           (static_cast<std::uint32_t>(bytes[offset + 2]) << 16) |
+           (static_cast<std::uint32_t>(bytes[offset + 3]) << 24);
+}
+
+std::string TagAt(const std::vector<std::uint8_t>& bytes, std::size_t offset) {
+    return std::string(bytes.begin() + static_cast<std::ptrdiff_t>(offset),
+                       bytes.begin() + static_cast<std::ptrdiff_t>(offset + 4));
+}
+
+std::int16_t PcmAt(const std::vector<std::uint8_t>& wav, std::size_t sample_index) {
+    return static_cast<std::int16_t>(ReadU16(wav, 44 + sample_index * 2));
+}
+
+}  // namespace
+
+TEST_CASE("wav encoder writes a canonical 44 byte header") {
+    const std::vector<float> pcm{0.0f, 0.5f, -0.5f, 1.0f};
+    const std::vector<std::uint8_t> wav = EncodeWav16Mono(pcm, 16000);
+    REQUIRE(wav.size() == 52);
+    CHECK(TagAt(wav, 0) == "RIFF");
+    CHECK(TagAt(wav, 8) == "WAVE");
+    CHECK(TagAt(wav, 12) == "fmt ");
+    CHECK(TagAt(wav, 36) == "data");
+    CHECK(ReadU32(wav, 4) == 44);
+    CHECK(ReadU32(wav, 16) == 16);
+    CHECK(ReadU16(wav, 20) == 1);
+    CHECK(ReadU16(wav, 22) == 1);
+    CHECK(ReadU32(wav, 24) == 16000);
+    CHECK(ReadU32(wav, 28) == 32000);
+    CHECK(ReadU16(wav, 32) == 2);
+    CHECK(ReadU16(wav, 34) == 16);
+    CHECK(ReadU32(wav, 40) == 8);
+}
+
+TEST_CASE("wav encoder roundtrips sample values") {
+    const std::vector<float> pcm{0.0f, 0.5f, -0.5f, 1.0f, -1.0f, 0.25f};
+    const std::vector<std::uint8_t> wav = EncodeWav16Mono(pcm, 16000);
+    CHECK(PcmAt(wav, 0) == 0);
+    CHECK(PcmAt(wav, 1) == 16384);
+    CHECK(PcmAt(wav, 2) == -16384);
+    CHECK(PcmAt(wav, 3) == 32767);
+    CHECK(PcmAt(wav, 4) == -32767);
+    CHECK(PcmAt(wav, 5) == 8192);
+}
+
+TEST_CASE("wav encoder clamps out of range samples") {
+    const std::vector<float> pcm{2.0f, -2.0f, 100.0f, -100.0f};
+    const std::vector<std::uint8_t> wav = EncodeWav16Mono(pcm, 16000);
+    CHECK(PcmAt(wav, 0) == 32767);
+    CHECK(PcmAt(wav, 1) == -32767);
+    CHECK(PcmAt(wav, 2) == 32767);
+    CHECK(PcmAt(wav, 3) == -32767);
+}
+
+TEST_CASE("wav encoder accepts empty audio") {
+    const std::vector<float> pcm;
+    const std::vector<std::uint8_t> wav = EncodeWav16Mono(pcm, 16000);
+    CHECK(wav.size() == 44);
+    CHECK(ReadU32(wav, 4) == 36);
+    CHECK(ReadU32(wav, 40) == 0);
+}
+
+TEST_CASE("wav encoder rejects a zero sample rate") {
+    const std::vector<float> pcm{0.5f};
+    CHECK_THROWS_AS(EncodeWav16Mono(pcm, 0), std::runtime_error);
+}
