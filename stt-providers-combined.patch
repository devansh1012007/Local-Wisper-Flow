diff --git a/tests/data/README.md b/tests/data/README.md
new file mode 100644
index 0000000..606d9c7
--- /dev/null
+++ b/tests/data/README.md
@@ -0,0 +1,37 @@
+# tests/data — local-only test assets
+
+Everything in this directory is git-ignored except this README, so recordings
+and fixtures can never leak into commits.
+
+## Gnani smoke test assets
+
+`scripts/gnani_smoke.py` accepts a recorded clip via `--file`. Requirements
+imposed by the Gnani Prisma STT v3 contract:
+
+- WAV, 16-bit PCM (not float), single channel (mono)
+- 16 000 Hz sample rate
+- at most 30 seconds (the endpoint rejects longer audio)
+
+Produce a compliant clip from any recording with ffmpeg:
+
+```sh
+ffmpeg -i raw.wav -ar 16000 -ac 1 -c:a pcm_s16le tests/data/sample.wav
+```
+
+or with sox:
+
+```sh
+sox raw.wav -r 16000 -c 1 -b 16 tests/data/sample.wav
+```
+
+A 10–15 second clip of natural speech in the language you plan to dictate in
+gives the most useful contract check. Silence also works: it exercises the
+"empty transcript is a success, not an error" branch.
+
+## Rules
+
+- Never commit audio files, transcripts of real speech, or API keys.
+- The smoke script reads the key only from the `GNANI_API_KEY` environment
+  variable; never paste it on the command line or into files under this tree.
+- Files written by `config_test.cpp` (config_test.json) are throwaway and are
+  re-created on every run.
diff --git a/tests/gnani_provider_test.cpp b/tests/gnani_provider_test.cpp
new file mode 100644
index 0000000..102c757
--- /dev/null
+++ b/tests/gnani_provider_test.cpp
@@ -0,0 +1,197 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/GnaniProvider.h"
+#include "stt/cloud/GnaniContract.h"
+
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct ScriptedResponse {
+    int status = 200;
+    std::string body = R"({"transcript":"clip"})";
+    std::string request_id_header = "req-id";
+    bool throw_timeout = false;
+    bool throw_network = false;
+};
+
+class FakeTransport final : public IHttpTransport {
+public:
+    explicit FakeTransport(std::vector<ScriptedResponse> script) : script_(std::move(script)) {}
+
+    HttpResponse Post(const HttpRequest& request) override {
+        requests_.push_back(request);
+        if (index_ >= script_.size()) {
+            throw std::runtime_error("FakeTransport: script exhausted");
+        }
+        const ScriptedResponse& step = script_[index_++];
+        if (step.throw_timeout) {
+            throw HttpTransportError(HttpTransportErrorKind::Timeout, "timed out");
+        }
+        if (step.throw_network) {
+            throw HttpTransportError(HttpTransportErrorKind::Network, "connection reset");
+        }
+        HttpResponse response;
+        response.status = step.status;
+        response.body.assign(step.body.begin(), step.body.end());
+        if (!step.request_id_header.empty()) {
+            response.headers.emplace_back("X-Request-Id", step.request_id_header);
+        }
+        return response;
+    }
+
+    const std::vector<HttpRequest>& Requests() const {
+        return requests_;
+    }
+
+private:
+    std::vector<ScriptedResponse> script_;
+    std::vector<HttpRequest> requests_;
+    std::size_t index_ = 0;
+};
+
+GnaniProviderSettings Settings() {
+    GnaniProviderSettings settings;
+    settings.api_key_id = "key-id-1";
+    settings.max_clips = 40;
+    return settings;
+}
+
+std::vector<float> ConstantAudio(std::size_t samples) {
+    return std::vector<float>(samples, 0.3f);
+}
+
+}  // namespace
+
+TEST_CASE("provider transcribes one clip through the transport") {
+    FakeTransport transport({ScriptedResponse()});
+    GnaniProvider provider(transport, Settings());
+    const SttTranscription result = provider.Transcribe(ConstantAudio(16000), {});
+    CHECK(result.success);
+    CHECK(result.text == "clip");
+    REQUIRE(result.attempts.size() == 1);
+    CHECK(result.attempts[0].provider == "gnani");
+    CHECK(result.attempts[0].http_status == 200);
+    CHECK(result.attempts[0].request_id == "req-id");
+    CHECK(result.attempts[0].bytes_sent > 0);
+    CHECK(result.attempts[0].bytes_received > 0);
+    CHECK(result.attempts[0].latency.count() >= 0);
+}
+
+TEST_CASE("provider sends the documented request shape") {
+    FakeTransport transport({ScriptedResponse()});
+    GnaniProvider provider(transport, Settings());
+    provider.Transcribe(ConstantAudio(1600), {});
+    REQUIRE(transport.Requests().size() == 1);
+    const HttpRequest& request = transport.Requests()[0];
+    CHECK(request.host == GnaniContract::kHost);
+    CHECK(request.path == GnaniContract::kPath);
+    REQUIRE(request.headers.size() == 1);
+    CHECK(request.headers[0].first == GnaniContract::kApiKeyHeader);
+    CHECK(request.headers[0].second == "key-id-1");
+    CHECK(request.content_type.find("multipart/form-data") == 0);
+    CHECK(request.timeout_ms == Settings().timeout_ms);
+    const std::string body(request.body.begin(), request.body.end());
+    CHECK(body.find("name=\"model\"\r\n\r\nprisma-v3.0") != std::string::npos);
+    CHECK(body.find("name=\"language\"\r\n\r\nindic-auto") != std::string::npos);
+    const std::string audio_header =
+        "Content-Disposition: form-data; name=\"audio\"; filename=\"audio.wav\"\r\n"
+        "Content-Type: audio/wav\r\n\r\n";
+    const std::size_t audio_at = body.find(audio_header);
+    REQUIRE(audio_at != std::string::npos);
+    CHECK(body.compare(audio_at + audio_header.size(), 4, "RIFF") == 0);
+}
+
+TEST_CASE("provider splits long audio into clip requests and joins transcripts") {
+    FakeTransport transport({ScriptedResponse{200, R"({"transcript":"one"})", "r1"},
+                             ScriptedResponse{200, R"({"transcript":"two"})", "r2"},
+                             ScriptedResponse{200, R"({"transcript":"three"})", "r3"}});
+    GnaniProvider provider(transport, Settings());
+    const SttTranscription result = provider.Transcribe(ConstantAudio(1040000), {});
+    CHECK(result.success);
+    CHECK(result.text == "one two three");
+    CHECK(transport.Requests().size() == 3);
+    REQUIRE(result.attempts.size() == 3);
+    CHECK(result.attempts[0].request_id == "r1");
+    CHECK(result.attempts[2].request_id == "r3");
+}
+
+TEST_CASE("provider maps transport timeouts and network failures") {
+    ScriptedResponse timeout_step;
+    timeout_step.throw_timeout = true;
+    FakeTransport timeout_transport({timeout_step});
+    GnaniProvider timeout_provider(timeout_transport, Settings());
+    SttTranscription result = timeout_provider.Transcribe(ConstantAudio(16000), {});
+    CHECK(!result.success);
+    CHECK(result.error == SttErrorCategory::Timeout);
+    CHECK(result.text.empty());
+
+    ScriptedResponse network_step;
+    network_step.throw_network = true;
+    FakeTransport network_transport({network_step});
+    GnaniProvider network_provider(network_transport, Settings());
+    result = network_provider.Transcribe(ConstantAudio(16000), {});
+    CHECK(!result.success);
+    CHECK(result.error == SttErrorCategory::Network);
+
+    FakeTransport generic_transport({});
+    GnaniProvider generic_provider(generic_transport, Settings());
+    result = generic_provider.Transcribe(ConstantAudio(16000), {});
+    CHECK(!result.success);
+    CHECK(result.error == SttErrorCategory::Network);
+}
+
+TEST_CASE("provider aborts remaining clips after an error status") {
+    FakeTransport transport({ScriptedResponse{401, R"({"error":"key rejected"})", "r1"}});
+    GnaniProvider provider(transport, Settings());
+    const SttTranscription result = provider.Transcribe(ConstantAudio(1040000), {});
+    CHECK(!result.success);
+    CHECK(result.error == SttErrorCategory::Auth);
+    CHECK(result.text.empty());
+    CHECK(transport.Requests().size() == 1);
+}
+
+TEST_CASE("provider treats an empty transcript as success") {
+    FakeTransport transport({ScriptedResponse{200, R"({"transcript":""})"}});
+    GnaniProvider provider(transport, Settings());
+    const SttTranscription result = provider.Transcribe(ConstantAudio(16000), {});
+    CHECK(result.success);
+    CHECK(result.text.empty());
+    CHECK(result.error == SttErrorCategory::None);
+}
+
+TEST_CASE("provider honors cancellation between clips") {
+    FakeTransport transport({ScriptedResponse{200, R"({"transcript":"one"})"}});
+    GnaniProvider provider(transport, Settings());
+    std::size_t checks = 0;
+    const SttCancelCheck cancel = [&checks] { return ++checks >= 2; };
+    const SttTranscription result = provider.Transcribe(ConstantAudio(1040000), cancel);
+    CHECK(result.cancelled);
+    CHECK(result.error == SttErrorCategory::Cancelled);
+    CHECK(result.text.empty());
+    CHECK(transport.Requests().size() == 1);
+}
+
+TEST_CASE("provider stops after the configured clip budget") {
+    FakeTransport transport({ScriptedResponse{200, R"({"transcript":"one"})"},
+                             ScriptedResponse{200, R"({"transcript":"two"})"}});
+    GnaniProviderSettings settings = Settings();
+    settings.max_clips = 2;
+    GnaniProvider provider(transport, settings);
+    const SttTranscription result = provider.Transcribe(ConstantAudio(1040000), {});
+    CHECK(result.success);
+    CHECK(result.text == "one two");
+    CHECK(transport.Requests().size() == 2);
+}
+
+TEST_CASE("provider skips the transport for empty audio") {
+    FakeTransport transport({});
+    GnaniProvider provider(transport, Settings());
+    const SttTranscription result = provider.Transcribe({}, {});
+    CHECK(result.success);
+    CHECK(result.text.empty());
+    CHECK(transport.Requests().empty());
+}
diff --git a/tests/gnani_request_test.cpp b/tests/gnani_request_test.cpp
new file mode 100644
index 0000000..411a34e
--- /dev/null
+++ b/tests/gnani_request_test.cpp
@@ -0,0 +1,103 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/GnaniContract.h"
+#include "stt/cloud/GnaniRequest.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::string AsString(const std::vector<std::uint8_t>& bytes) {
+    return std::string(bytes.begin(), bytes.end());
+}
+
+bool Contains(const std::vector<std::uint8_t>& haystack, const std::string& needle) {
+    return std::search(haystack.begin(), haystack.end(), needle.begin(), needle.end()) !=
+           haystack.end();
+}
+
+std::size_t Count(const std::string& haystack, char needle) {
+    return static_cast<std::size_t>(
+        std::count(haystack.begin(), haystack.end(), needle));
+}
+
+GnaniRequestOptions Options() {
+    GnaniRequestOptions options;
+    options.api_key_id = "test-key-id";
+    options.model = "prisma-v3.0";
+    options.language = "indic-auto";
+    return options;
+}
+
+}  // namespace
+
+TEST_CASE("gnani request targets the documented endpoint and headers") {
+    const std::vector<float> pcm(16, 0.0f);
+    const HttpRequest request = BuildGnaniRequest(pcm, 16000, Options());
+    CHECK(request.host == GnaniContract::kHost);
+    CHECK(request.path == GnaniContract::kPath);
+    REQUIRE(request.headers.size() == 1);
+    CHECK(request.headers[0].first == "X-API-Key-ID");
+    CHECK(request.headers[0].second == "test-key-id");
+    CHECK(request.content_type.find("multipart/form-data") == 0);
+    CHECK(request.content_type.find(GnaniContract::kBoundary) != std::string::npos);
+}
+
+TEST_CASE("gnani request embeds model, language, and wav audio") {
+    const std::vector<float> pcm{0.5f, -0.5f, 0.25f};
+    const HttpRequest request = BuildGnaniRequest(pcm, 16000, Options());
+    CHECK(Contains(request.body, "name=\"model\"\r\n\r\nprisma-v3.0"));
+    CHECK(Contains(request.body, "name=\"language\"\r\n\r\nindic-auto"));
+    CHECK(Contains(request.body, "name=\"audio\"; filename=\"audio.wav\""));
+    CHECK(Contains(request.body, "Content-Type: audio/wav"));
+    CHECK(Contains(request.body, "RIFF"));
+    CHECK(Contains(request.body, "WAVE"));
+    const std::string body = AsString(request.body);
+    const std::string expected_tail = "\r\n--" + std::string(GnaniContract::kBoundary) + "--\r\n";
+    CHECK(body.substr(body.size() - expected_tail.size()) == expected_tail);
+}
+
+TEST_CASE("gnani request omits the keyterms field when none are given") {
+    const std::vector<float> pcm(4, 0.0f);
+    const HttpRequest request = BuildGnaniRequest(pcm, 16000, Options());
+    CHECK(!Contains(request.body, "name=\"keyterms\""));
+}
+
+TEST_CASE("gnani request caps and filters keyterms") {
+    const std::vector<float> pcm(4, 0.0f);
+    GnaniRequestOptions options = Options();
+    for (std::size_t i = 0; i < 260; ++i) {
+        options.keyterms.push_back("term" + std::to_string(i));
+    }
+    options.keyterms.push_back("unsafe,term");
+    options.keyterms.push_back("unsafe\r\nterm");
+    options.keyterms.push_back("");
+    const HttpRequest request = BuildGnaniRequest(pcm, 16000, options);
+    const std::string body = AsString(request.body);
+    const std::size_t field = body.find("name=\"keyterms\"\r\n\r\n");
+    REQUIRE(field != std::string::npos);
+    const std::size_t value_begin = field + std::string("name=\"keyterms\"\r\n\r\n").size();
+    const std::size_t value_end = body.find("\r\n--", value_begin);
+    const std::string joined = body.substr(value_begin, value_end - value_begin);
+    CHECK(Count(joined, ',') == GnaniContract::kKeytermsCap - 1);
+    CHECK(joined.find("term199") != std::string::npos);
+    CHECK(joined.find("term200") == std::string::npos);
+    CHECK(joined.find("unsafe") == std::string::npos);
+}
+
+TEST_CASE("gnani request rejects missing credentials and settings") {
+    const std::vector<float> pcm(4, 0.0f);
+    GnaniRequestOptions options = Options();
+    options.api_key_id = "";
+    CHECK_THROWS_AS(BuildGnaniRequest(pcm, 16000, options), std::runtime_error);
+    options = Options();
+    options.model = "";
+    CHECK_THROWS_AS(BuildGnaniRequest(pcm, 16000, options), std::runtime_error);
+    options = Options();
+    options.language = "";
+    CHECK_THROWS_AS(BuildGnaniRequest(pcm, 16000, options), std::runtime_error);
+}
diff --git a/tests/gnani_response_test.cpp b/tests/gnani_response_test.cpp
new file mode 100644
index 0000000..3af26ce
--- /dev/null
+++ b/tests/gnani_response_test.cpp
@@ -0,0 +1,110 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/GnaniResponse.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::vector<std::uint8_t> Bytes(const std::string& text) {
+    return std::vector<std::uint8_t>(text.begin(), text.end());
+}
+
+}  // namespace
+
+TEST_CASE("gnani response parses a success with transcript and header request id") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"transcript":"namaskara loka"})"), "req-123", success,
+                             failure));
+    CHECK(success.transcript == "namaskara loka");
+    CHECK(success.request_id == "req-123");
+}
+
+TEST_CASE("gnani response treats an empty transcript as success") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"transcript":""})"), "req-456", success, failure));
+    CHECK(success.transcript.empty());
+    CHECK(success.request_id == "req-456");
+}
+
+TEST_CASE("gnani response falls back to alternate transcript field names") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"text":"via text"})"), "", success, failure));
+    CHECK(success.transcript == "via text");
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"data":{"transcript":"nested"}})"), "", success,
+                             failure));
+    CHECK(success.transcript == "nested");
+}
+
+TEST_CASE("gnani response picks the body request id when the header is absent") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(ParseGnaniResponse(200, Bytes(R"({"transcript":"hi","request_id":"body-id"})"), "",
+                             success, failure));
+    CHECK(success.request_id == "body-id");
+}
+
+TEST_CASE("gnani response parses the error object shape") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(401,
+                              Bytes(R"({"error":{"code":"invalid_api_key","message":"key rejected"}})"),
+                              "req-1", success, failure));
+    CHECK(failure.category == SttErrorCategory::Auth);
+    CHECK(failure.http_status == 401);
+    CHECK(failure.request_id == "req-1");
+    CHECK(failure.detail == "invalid_api_key: key rejected");
+}
+
+TEST_CASE("gnani response parses the error string shape") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(429, Bytes(R"({"error":"too many requests"})"), "", success,
+                              failure));
+    CHECK(failure.category == SttErrorCategory::RateLimited);
+    CHECK(failure.detail == "too many requests");
+}
+
+TEST_CASE("gnani response parses the message and detail shapes") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(500, Bytes(R"({"message":"upstream burst"})"), "req-2", success,
+                              failure));
+    CHECK(failure.category == SttErrorCategory::Server);
+    CHECK(failure.detail == "upstream burst");
+    CHECK(!ParseGnaniResponse(400, Bytes(R"({"detail":"audio must be 16 kHz"})"), "", success,
+                              failure));
+    CHECK(failure.category == SttErrorCategory::InvalidRequest);
+    CHECK(failure.detail == "audio must be 16 kHz");
+}
+
+TEST_CASE("gnani response classifies transport level status codes") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(403, Bytes(R"({})"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Auth);
+    CHECK(!ParseGnaniResponse(408, Bytes(R"({})"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Timeout);
+    CHECK(!ParseGnaniResponse(413, Bytes(R"({})"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::PayloadTooLarge);
+    CHECK(!ParseGnaniResponse(503, Bytes("{}"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Server);
+}
+
+TEST_CASE("gnani response survives malformed bodies without throwing") {
+    GnaniSuccess success;
+    GnaniFailure failure;
+    CHECK(!ParseGnaniResponse(200, Bytes("not json at all"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Unknown);
+    CHECK(!ParseGnaniResponse(500, Bytes("still not json"), "", success, failure));
+    CHECK(failure.category == SttErrorCategory::Server);
+    CHECK(!ParseGnaniResponse(200, Bytes("[]"), "", success, failure));
+    CHECK(failure.detail == "success body is not a JSON object");
+    CHECK(!ParseGnaniResponse(200, Bytes(R"({"unexpected":"shape"})"), "", success, failure));
+    CHECK(failure.detail == "no transcript field in success body");
+}
diff --git a/tests/multipart_builder_test.cpp b/tests/multipart_builder_test.cpp
new file mode 100644
index 0000000..e5544a9
--- /dev/null
+++ b/tests/multipart_builder_test.cpp
@@ -0,0 +1,95 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/MultipartBuilder.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::string AsString(const std::vector<std::uint8_t>& bytes) {
+    return std::string(bytes.begin(), bytes.end());
+}
+
+std::size_t Find(const std::vector<std::uint8_t>& haystack, const std::string& needle,
+                 std::size_t from = 0) {
+    const auto it = std::search(haystack.begin() + static_cast<std::ptrdiff_t>(from),
+                                haystack.end(), needle.begin(), needle.end());
+    return it == haystack.end() ? std::string::npos
+                                : static_cast<std::size_t>(it - haystack.begin());
+}
+
+const std::vector<std::uint8_t> kBinaryPayload{0x01, 0x00, 0xFF, 0x0D, 0x0A, 0x00, 0xFE, 0x7F};
+const std::string kTerminator = "\r\n--BOUND--\r\n";
+
+}  // namespace
+
+TEST_CASE("multipart builder emits fields in canonical form") {
+    MultipartBuilder builder("BOUND");
+    builder.AddField("model", "prisma-v3.0");
+    const std::vector<std::uint8_t> body = builder.Build();
+    CHECK(AsString(body) ==
+          "--BOUND\r\nContent-Disposition: form-data; name=\"model\"\r\n\r\nprisma-v3.0\r\n"
+          "--BOUND--\r\n");
+}
+
+TEST_CASE("multipart builder emits file parts with content type and payload") {
+    MultipartBuilder builder("BOUND");
+    builder.AddField("language", "indic-auto");
+    builder.AddFile("audio", "audio.wav", "audio/wav", kBinaryPayload);
+    const std::vector<std::uint8_t> body = builder.Build();
+    const std::string expected_field =
+        "--BOUND\r\nContent-Disposition: form-data; name=\"language\"\r\n\r\nindic-auto\r\n";
+    const std::string expected_header =
+        "--BOUND\r\nContent-Disposition: form-data; name=\"audio\"; filename=\"audio.wav\"\r\n"
+        "Content-Type: audio/wav\r\n\r\n";
+    const std::size_t field_offset = Find(body, expected_field);
+    const std::size_t header_offset = Find(body, expected_header);
+    REQUIRE(field_offset == 0);
+    REQUIRE(header_offset == expected_field.size());
+    const std::size_t payload_offset = header_offset + expected_header.size();
+    REQUIRE(body.size() == payload_offset + kBinaryPayload.size() + kTerminator.size());
+    for (std::size_t i = 0; i < kBinaryPayload.size(); ++i) {
+        CHECK(body[payload_offset + i] == kBinaryPayload[i]);
+    }
+    CHECK(AsString(std::vector<std::uint8_t>(body.end() - static_cast<std::ptrdiff_t>(kTerminator.size()),
+                                            body.end())) == kTerminator);
+}
+
+TEST_CASE("multipart builder keeps binary payloads byte exact") {
+    MultipartBuilder builder("BOUND");
+    builder.AddFile("audio", "clip.wav", "audio/wav", kBinaryPayload);
+    const std::vector<std::uint8_t> body = builder.Build();
+    const std::string header =
+        "--BOUND\r\nContent-Disposition: form-data; name=\"audio\"; filename=\"clip.wav\"\r\n"
+        "Content-Type: audio/wav\r\n\r\n";
+    const std::size_t payload_offset = Find(body, header) + header.size();
+    for (std::size_t i = 0; i < kBinaryPayload.size(); ++i) {
+        CHECK(body[payload_offset + i] == kBinaryPayload[i]);
+    }
+}
+
+TEST_CASE("multipart builder rejects header and value injection") {
+    CHECK_THROWS_AS(MultipartBuilder builder(""), std::runtime_error);
+    CHECK_THROWS_AS(MultipartBuilder builder("bad\r\nboundary"), std::runtime_error);
+    MultipartBuilder builder("BOUND");
+    CHECK_THROWS_AS(builder.AddField("name\"; evil", "v"), std::runtime_error);
+    CHECK_THROWS_AS(builder.AddField("model", "v\r\nX-Evil: 1"), std::runtime_error);
+    CHECK_THROWS_AS(builder.AddField("model", "v--BOUND--"), std::runtime_error);
+    CHECK_THROWS_AS(builder.AddFile("audio", "a.wav\r\nEvil", "audio/wav", {}), std::runtime_error);
+    CHECK_THROWS_AS(builder.AddFile("audio", "a.wav", "audio/wav \"x\"", {}), std::runtime_error);
+}
+
+TEST_CASE("multipart builder with no parts emits only the terminator") {
+    MultipartBuilder builder("BOUND");
+    const std::vector<std::uint8_t> body = builder.Build();
+    CHECK(AsString(body) == "--BOUND--\r\n");
+}
+
+TEST_CASE("multipart builder content type carries the boundary") {
+    MultipartBuilder builder("lwf-abc123");
+    CHECK(builder.ContentType() == "multipart/form-data; boundary=lwf-abc123");
+}
diff --git a/tests/stt_router_test.cpp b/tests/stt_router_test.cpp
new file mode 100644
index 0000000..18062b1
--- /dev/null
+++ b/tests/stt_router_test.cpp
@@ -0,0 +1,203 @@
+#include <doctest/doctest.h>
+
+#include "core/SttRouter.h"
+
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+class ScriptedLocal final : public IInferenceProvider {
+public:
+    ScriptedLocal(std::string tag, bool fail) : tag_(std::move(tag)), fail_(fail) {}
+
+    std::string Transcribe(const std::vector<float>&) override {
+        ++transcribe_calls;
+        if (fail_) {
+            throw std::runtime_error("local failure");
+        }
+        return "local:" + tag_;
+    }
+
+    std::string ProcessText(const std::string& text, const std::string&) override {
+        ++process_calls;
+        return "processed:" + text;
+    }
+
+    int transcribe_calls = 0;
+    int process_calls = 0;
+
+private:
+    std::string tag_;
+    bool fail_;
+};
+
+class ScriptedCloud final : public ISttProvider {
+public:
+    SttTranscription Transcribe(const std::vector<float>& audio_pcm,
+                                const SttCancelCheck& cancel_check) override {
+        ++calls;
+        last_audio_size = audio_pcm.size();
+        received_cancel_check = static_cast<bool>(cancel_check);
+        if (cancel_check) {
+            (void)cancel_check();
+        }
+        SttTranscription result;
+        result.text = outcome_text;
+        result.success = outcome_success;
+        result.cancelled = outcome_cancelled;
+        result.error = outcome_error;
+        SttAttemptStats attempt;
+        attempt.provider = "gnani";
+        attempt.http_status = outcome_status;
+        attempt.bytes_sent = 1024;
+        attempt.bytes_received = 256;
+        attempt.latency = std::chrono::milliseconds(42);
+        result.attempts.push_back(attempt);
+        return result;
+    }
+
+    std::string outcome_text = "cloud:text";
+    bool outcome_success = true;
+    bool outcome_cancelled = false;
+    SttErrorCategory outcome_error = SttErrorCategory::None;
+    int outcome_status = 200;
+    int calls = 0;
+    std::size_t last_audio_size = 0;
+    bool received_cancel_check = false;
+};
+
+SttRoutingConfig CloudConfig() {
+    SttRoutingConfig config;
+    config.provider = "gnani";
+    config.consent_accepted = true;
+    config.api_key_source = [] { return std::string("key-present"); };
+    return config;
+}
+
+}  // namespace
+
+TEST_CASE("router stays local by default") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false),
+                     std::unique_ptr<ISttProvider>(cloud), SttRoutingConfig{});
+    const std::vector<float> pcm(16, 0.0f);
+    CHECK(router.Transcribe(pcm) == "local:l");
+    CHECK(cloud->calls == 0);
+}
+
+TEST_CASE("router uses cloud when opted in with consent and a key") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false),
+                     std::unique_ptr<ISttProvider>(cloud), CloudConfig());
+    const std::vector<float> pcm(32, 0.0f);
+    CHECK(router.Transcribe(pcm) == "cloud:text");
+    CHECK(cloud->calls == 1);
+    CHECK(cloud->last_audio_size == 32);
+}
+
+TEST_CASE("router refuses cloud without consent") {
+    SttRoutingConfig config = CloudConfig();
+    config.consent_accepted = false;
+    ScriptedCloud* cloud = new ScriptedCloud();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false),
+                     std::unique_ptr<ISttProvider>(cloud), config);
+    CHECK(router.Transcribe({16, 0.0f}) == "local:l");
+    CHECK(cloud->calls == 0);
+}
+
+TEST_CASE("router refuses cloud without an api key") {
+    SttRoutingConfig config = CloudConfig();
+    config.api_key_source = [] { return std::string(); };
+    ScriptedCloud* cloud = new ScriptedCloud();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false),
+                     std::unique_ptr<ISttProvider>(cloud), config);
+    CHECK(router.Transcribe({16, 0.0f}) == "local:l");
+    CHECK(cloud->calls == 0);
+}
+
+TEST_CASE("router accepts a null cloud provider") {
+    SttRoutingConfig config = CloudConfig();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false), nullptr, config);
+    CHECK(router.Transcribe({16, 0.0f}) == "local:l");
+}
+
+TEST_CASE("router falls back to local on cloud failure") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    cloud->outcome_success = false;
+    cloud->outcome_error = SttErrorCategory::Auth;
+    cloud->outcome_text.clear();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false),
+                     std::unique_ptr<ISttProvider>(cloud), CloudConfig());
+    CHECK(router.Transcribe({16, 0.0f}) == "local:l");
+    CHECK(cloud->calls == 1);
+    CHECK(router.LastCloudResult().error == SttErrorCategory::Auth);
+}
+
+TEST_CASE("router never calls local when cloud succeeds") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", true),
+                     std::unique_ptr<ISttProvider>(cloud), CloudConfig());
+    CHECK(router.Transcribe({16, 0.0f}) == "cloud:text");
+}
+
+TEST_CASE("router does not fall back when cloud returns empty text") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    cloud->outcome_text.clear();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", true),
+                     std::unique_ptr<ISttProvider>(cloud), CloudConfig());
+    CHECK(router.Transcribe({16, 0.0f}).empty());
+    CHECK(cloud->calls == 1);
+}
+
+TEST_CASE("router does not fall back when cloud was cancelled") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    cloud->outcome_cancelled = true;
+    cloud->outcome_text.clear();
+    cloud->outcome_error = SttErrorCategory::Cancelled;
+    SttRouter router(std::make_unique<ScriptedLocal>("l", true),
+                     std::unique_ptr<ISttProvider>(cloud), CloudConfig());
+    CHECK(router.Transcribe({16, 0.0f}).empty());
+    CHECK(cloud->calls == 1);
+}
+
+TEST_CASE("router forwards the cancel check to the cloud provider") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false),
+                     std::unique_ptr<ISttProvider>(cloud), CloudConfig());
+    bool flag = false;
+    router.SetCancelCheck([&flag] { return flag; });
+    router.Transcribe({16, 0.0f});
+    CHECK(cloud->received_cancel_check);
+    flag = true;
+    router.Transcribe({16, 0.0f});
+}
+
+TEST_CASE("router routes text processing to the local provider") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false),
+                     std::unique_ptr<ISttProvider>(cloud), CloudConfig());
+    CHECK(router.ProcessText("hi", "prompt") == "processed:hi");
+    CHECK(cloud->calls == 0);
+}
+
+TEST_CASE("router records cloud attempt statistics") {
+    ScriptedCloud* cloud = new ScriptedCloud();
+    SttRouter router(std::make_unique<ScriptedLocal>("l", false),
+                     std::unique_ptr<ISttProvider>(cloud), CloudConfig());
+    router.Transcribe({16, 0.0f});
+    const SttTranscription& last = router.LastCloudResult();
+    REQUIRE(last.attempts.size() == 1);
+    CHECK(last.attempts[0].provider == "gnani");
+    CHECK(last.attempts[0].http_status == 200);
+    CHECK(last.attempts[0].bytes_sent == 1024);
+    CHECK(last.attempts[0].bytes_received == 256);
+    CHECK(last.attempts[0].latency.count() == 42);
+}
+
+TEST_CASE("router requires a local provider") {
+    CHECK_THROWS_AS(SttRouter router(nullptr, nullptr, SttRoutingConfig{}),
+                    std::invalid_argument);
+}
diff --git a/tests/wav_encoder_test.cpp b/tests/wav_encoder_test.cpp
new file mode 100644
index 0000000..15fe706
--- /dev/null
+++ b/tests/wav_encoder_test.cpp
@@ -0,0 +1,85 @@
+#include <doctest/doctest.h>
+
+#include "stt/cloud/WavEncoder.h"
+
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::uint16_t ReadU16(const std::vector<std::uint8_t>& bytes, std::size_t offset) {
+    return static_cast<std::uint16_t>(static_cast<std::uint16_t>(bytes[offset]) |
+                                      (static_cast<std::uint16_t>(bytes[offset + 1]) << 8));
+}
+
+std::uint32_t ReadU32(const std::vector<std::uint8_t>& bytes, std::size_t offset) {
+    return static_cast<std::uint32_t>(bytes[offset]) |
+           (static_cast<std::uint32_t>(bytes[offset + 1]) << 8) |
+           (static_cast<std::uint32_t>(bytes[offset + 2]) << 16) |
+           (static_cast<std::uint32_t>(bytes[offset + 3]) << 24);
+}
+
+std::string TagAt(const std::vector<std::uint8_t>& bytes, std::size_t offset) {
+    return std::string(bytes.begin() + static_cast<std::ptrdiff_t>(offset),
+                       bytes.begin() + static_cast<std::ptrdiff_t>(offset + 4));
+}
+
+std::int16_t PcmAt(const std::vector<std::uint8_t>& wav, std::size_t sample_index) {
+    return static_cast<std::int16_t>(ReadU16(wav, 44 + sample_index * 2));
+}
+
+}  // namespace
+
+TEST_CASE("wav encoder writes a canonical 44 byte header") {
+    const std::vector<float> pcm{0.0f, 0.5f, -0.5f, 1.0f};
+    const std::vector<std::uint8_t> wav = EncodeWav16Mono(pcm, 16000);
+    REQUIRE(wav.size() == 52);
+    CHECK(TagAt(wav, 0) == "RIFF");
+    CHECK(TagAt(wav, 8) == "WAVE");
+    CHECK(TagAt(wav, 12) == "fmt ");
+    CHECK(TagAt(wav, 36) == "data");
+    CHECK(ReadU32(wav, 4) == 44);
+    CHECK(ReadU32(wav, 16) == 16);
+    CHECK(ReadU16(wav, 20) == 1);
+    CHECK(ReadU16(wav, 22) == 1);
+    CHECK(ReadU32(wav, 24) == 16000);
+    CHECK(ReadU32(wav, 28) == 32000);
+    CHECK(ReadU16(wav, 32) == 2);
+    CHECK(ReadU16(wav, 34) == 16);
+    CHECK(ReadU32(wav, 40) == 8);
+}
+
+TEST_CASE("wav encoder roundtrips sample values") {
+    const std::vector<float> pcm{0.0f, 0.5f, -0.5f, 1.0f, -1.0f, 0.25f};
+    const std::vector<std::uint8_t> wav = EncodeWav16Mono(pcm, 16000);
+    CHECK(PcmAt(wav, 0) == 0);
+    CHECK(PcmAt(wav, 1) == 16384);
+    CHECK(PcmAt(wav, 2) == -16384);
+    CHECK(PcmAt(wav, 3) == 32767);
+    CHECK(PcmAt(wav, 4) == -32767);
+    CHECK(PcmAt(wav, 5) == 8192);
+}
+
+TEST_CASE("wav encoder clamps out of range samples") {
+    const std::vector<float> pcm{2.0f, -2.0f, 100.0f, -100.0f};
+    const std::vector<std::uint8_t> wav = EncodeWav16Mono(pcm, 16000);
+    CHECK(PcmAt(wav, 0) == 32767);
+    CHECK(PcmAt(wav, 1) == -32767);
+    CHECK(PcmAt(wav, 2) == 32767);
+    CHECK(PcmAt(wav, 3) == -32767);
+}
+
+TEST_CASE("wav encoder accepts empty audio") {
+    const std::vector<float> pcm;
+    const std::vector<std::uint8_t> wav = EncodeWav16Mono(pcm, 16000);
+    CHECK(wav.size() == 44);
+    CHECK(ReadU32(wav, 4) == 36);
+    CHECK(ReadU32(wav, 40) == 0);
+}
+
+TEST_CASE("wav encoder rejects a zero sample rate") {
+    const std::vector<float> pcm{0.5f};
+    CHECK_THROWS_AS(EncodeWav16Mono(pcm, 0), std::runtime_error);
+}
